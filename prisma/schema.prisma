generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// ==========================================
/// AUTH
/// ==========================================

model User {
  id              String  @id @default(uuid())
  name            String
  email           String  @unique
  passwordHash    String
  isEmailVerified Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  createdYears            Year[]                   @relation("YearCreator")
  yearMemberships         YearMember[]
  createdCards            Card[]                   @relation("CardCreator")

  @@map("users")
}

model EmailVerificationToken {
  id        String @id @default(uuid())
  tokenHash String @unique // SHA-256 do token enviado por e-mail

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String @id @default(uuid())
  tokenHash String @unique // SHA-256 do token enviado por e-mail

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String @id @default(uuid())
  tokenHash String @unique // SHA-256 do token opaco

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  // encadeamento da rotação: aponta para o token que substituiu este
  replacedByTokenId String?       @unique
  replacedByToken   RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  previousToken     RefreshToken? @relation("TokenRotation")

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

/// ==========================================
/// ANO (YEAR) + COLABORADORES
/// ==========================================

enum YearRole {
  ADMIN
  EDITOR
  PARTICIPANTE
}

model Year {
  id   String @id @default(uuid())
  year Int

  creatorId String
  creator   User   @relation("YearCreator", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete -> permite restauração

  members YearMember[]
  cards   Card[]

  @@unique([creatorId, year]) // um usuário não cria o mesmo ano duas vezes
  @@index([deletedAt])
  @@map("years")
}

model YearMember {
  id String @id @default(uuid())

  yearId String
  year   Year   @relation(fields: [yearId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role YearRole

  invitedAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@unique([yearId, userId]) // usuário só pode ter 1 papel por ano
  @@map("year_members")
}

/// ==========================================
/// CARD (MÊS)
/// ==========================================

enum MonthStatus {
  EMPTY
  PARTIAL
  COMPLETED
}

enum CardStatusMode {
  AUTOMATIC
  MANUAL
}

model Card {
  id          String  @id @default(uuid())
  title       String
  description String?
  month       Int // 1 a 12 (validar range na aplicação)

  yearId String
  year   Year   @relation(fields: [yearId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CardCreator", fields: [createdById], references: [id])

  // Status: por padrão (AUTOMATIC) é sempre calculado a partir de
  // incomes/expenses. Se o usuário sobrescrever manualmente (MANUAL),
  // manualStatus prevalece até ele voltar pro modo automático.
  statusMode   CardStatusMode @default(AUTOMATIC)
  manualStatus MonthStatus?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete -> permite restaurar

  incomes  Income[]
  expenses Expense[]

  @@unique([yearId, month]) // garante no máximo 12 cards por ano, 1 por mês
  @@index([yearId, deletedAt])
  @@map("cards")
}

enum IncomeType {
  SALARIO
  RENDA_EXTRA
  OUTROS
}

enum RecurrenceType {
  NONE
  INSTALLMENT
  RECURRING
}

model Income {
  id          String     @id @default(uuid())
  description String
  type        IncomeType @default(SALARIO)
  value       Decimal    @db.Decimal(12, 2)
  date        DateTime // dia do lançamento — precisa cair no mês/ano do card (validado na aplicação)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // Agrupamento de parcelas/recorrência — groupId é o mesmo em todos os
  // registros gerados pela mesma operação (seja parcela ou ocorrência
  // recorrente). Sem groupId = lançamento avulso comum (RecurrenceType.NONE).
  recurrenceType    RecurrenceType @default(NONE)
  groupId           String?
  installmentNumber Int? // 1, 2, 3... (só quando INSTALLMENT)
  totalInstallments Int? // 24 (só quando INSTALLMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([groupId])
  @@map("incomes")
}

enum ExpenseCategory {
  MORADIA
  ALIMENTACAO
  TRANSPORTE
  SAUDE
  EDUCACAO
  LAZER
  VESTUARIO
  DIVIDAS
  INVESTIMENTOS
  COMPRAS
  ASSINATURAS
  PETS
  PRESENTES
  IMPOSTOS
  SEGUROS
  VIAGEM
  CUIDADOS_PESSOAIS
  MANUTENCAO
  DOACOES
  OUTROS
}

model Expense {
  id       String          @id @default(uuid())
  name     String
  category ExpenseCategory
  value    Decimal         @db.Decimal(12, 2)
  date     DateTime // dia do lançamento — precisa cair no mês/ano do card (validado na aplicação)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // Mesmo padrão do Income — ver comentário lá.
  recurrenceType    RecurrenceType @default(NONE)
  groupId           String?
  installmentNumber Int?
  totalInstallments Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cardId])
  @@index([groupId])
  @@map("expenses")
}
